{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurobuddy.local/schema/report-v2.json",
  "title": "Neuro-buddy V2 portable EEG analysis report",
  "type": "object",
  "required": ["schema_version", "pipeline_version", "report_id", "processing_status", "input_manifest", "recording", "classification", "routing", "quality", "shared_metrics", "specialized_metrics", "statistics", "visualizations", "events", "warnings", "errors", "provenance"],
  "properties": {
    "schema_version": {"type":"string", "pattern":"^2\\."},
    "pipeline_version": {"type":"string"},
    "report_id": {"type":"string", "minLength":4},
    "recording_id": {"type":"string"},
    "processing_status": {"enum": ["COMPLETE", "PARTIAL", "NEEDS_REVIEW", "INCOMPLETE", "FAILED"]},
    "input_manifest": {
      "type":"array",
      "items": {"type":"object", "required":["name","sha256","bytes"],
        "properties": {"name":{"type":"string"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"bytes":{"type":"integer","minimum":0}},
        "additionalProperties":true}
    },
    "recording": {"type":"object","required":["file"],"properties":{"file":{"type":"string"},"duration_s":{"type":"number","minimum":0},"sample_rate_hz":{"type":"number","exclusiveMinimum":0}},"additionalProperties":true},
    "classification": {"type":"object","required":["task_family","status","evidence","analysis_readiness"],
      "properties":{"task_family":{"enum":["GENERAL","ODDBALL","MOTOR","SLEEP","UNKNOWN"]},"subtype":{"type":["string","null"]},"status":{"type":"string"},"evidence":{"type":"array","items":{"type":"string"}},"analysis_readiness":{"type":"object","additionalProperties":{"type":"boolean"}}},"additionalProperties":true},
    "routing":{"type":"object"},
    "quality":{"type":"object"},
    "shared_metrics":{"type":"object"},
    "specialized_metrics":{"type":"object"},
    "statistics":{"type":"object"},
    "visualizations":{"type":"object"},
    "events": {"type":"object","required":["count","normalized"], "properties":{"count":{"type":"integer","minimum":0},"normalized":{"type":"array","items":{"type":"object"}}}},
    "warnings":{"type":"array","items":{"type":"string"}},
    "errors":{"type":"array","items":{"type":"object"}},
    "provenance":{"type":"object","required":["created_utc","mne_version"]}
  },
  "additionalProperties":true
}
